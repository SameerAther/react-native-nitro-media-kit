ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

MIN_IOS_VERSION = '16.0'

platform :ios, MIN_IOS_VERSION
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NitroMediaKitExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'NitroMediaKitTests' do
    # Resolve native symbols from TEST_HOST. Relinking the app's static pods
    # would run Nitro's HybridObject registration twice in the same process.
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
      # :ccache_enabled => true
    )

    # glog 0.3.5 includes these headers inside namespace google. Mark them
    # textual so Swift C++ interop does not turn those includes into illegal
    # nested module imports. This changes the module map, not third-party code.
    glog_modulemap = installer.sandbox.root.join('Target Support Files/glog/glog.modulemap')
    glog_target = installer.pod_targets.find { |target| target.pod_name == 'glog' }
    if glog_target&.root_spec&.version.to_s == '0.3.5' && glog_modulemap.exist?
      File.write(glog_modulemap, <<~MODULEMAP)
        module glog {
          umbrella header "glog-umbrella.h"
          textual header "glog/logging.h"
          textual header "glog/log_severity.h"
          textual header "glog/raw_logging.h"
          textual header "glog/stl_logging.h"
          textual header "glog/vlog_is_on.h"
          export *
        }
      MODULEMAP
    end

    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_IOS_VERSION
      end
    end

    installer.aggregate_targets.each do |agg|
      agg.user_project.native_targets.each do |nt|
        nt.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_IOS_VERSION
        end
      end
    end
  end
end
